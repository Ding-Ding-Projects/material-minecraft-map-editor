<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Amulet" version="1.0.0.0"/>
  <!--
    Declared here as well as in code. The ctypes call in amulet_map_editor.api.dpi
    runs inside the child process once Python is up; a manifest is read by the
    loader before any of our code exists, which also covers the brief moment the
    launcher process owns a window. Windows takes the first declaration it sees
    and refuses later ones, so the two agree on purpose: per-monitor v2, the only
    mode that rescales the window frame along with its contents and that survives
    a window being dragged between differently-scaled displays.

    Without this the process is treated as written before high-DPI displays and
    Windows bitmap-stretches the finished frame, which is why the interface
    arrived oversized and soft on a 150% laptop and correct on a 100% desktop.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor, System</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">True/PM</dpiAware>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Claiming these is what makes PerMonitorV2 eligible. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
    </application>
  </compatibility>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- A map editor edits files the user already owns. It must never ask
             for elevation, and asking would also break drag-and-drop from a
             non-elevated Explorer window. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
